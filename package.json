{
  "name": "chat-triggers-for-twitch",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck plugin that runs MCP Deck actions when commands are used in Twitch chat.",
  "type": "module",
  "license": "MIT",
  "author": "OrganismZero",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/install-plugin-deps.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "streamdeck dev",
    "link": "streamdeck link com.organismzero.chattriggers.sdPlugin",
    "restart": "streamdeck restart com.organismzero.chattriggers",
    "validate": "streamdeck validate com.organismzero.chattriggers.sdPlugin",
    "pack": "node scripts/install-plugin-deps.js ci && streamdeck pack com.organismzero.chattriggers.sdPlugin --output dist --force",
    "images": "node scripts/render-images.js",
    "marketplace": "node scripts/render-marketplace.js"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@resvg/resvg-js": "2.6.2"
  }
}
